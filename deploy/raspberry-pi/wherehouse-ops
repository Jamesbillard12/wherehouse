from datetime import datetime, timezone
from pathlib import Path
from typing import Optional
from urllib import error, parse, request

DEFAULT_ROOT = Path("/var/lib/wherehouse")
INSTALL_DIR = Path("/opt/wherehouse")
PRODUCT = "WhereHouse"
SUPPORTED_CHANNEL = "stable"
ARCHITECTURE = "arm64"
CURRENT_SCHEMA_REVISION = 13
SEMVER = re.compile(r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$")
STATE_NAME = "update-state.json"
LOCK_NAME = "lifecycle.lock"
STORAGE_STATE_NAME = "storage-state.json"
STORAGE_MOUNT = Path("/mnt/wherehouse-storage")
APPLIANCE_SOCKET = Path("/run/wherehouse/ops.sock")
STORAGE_CONFIRMATION = "ERASE AND USE THIS DRIVE"
NAS_SHARE = "Shared"
NAS_USER_RE = re.compile(r"^[a-z][a-z0-9_-]{0,30}$")
UUID_RE = re.compile(r"^[A-Fa-f0-9-]{4,64}$")


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def valid_filesystem_uuid(value: object) -> bool:
    if not isinstance(value, str) or not UUID_RE.fullmatch(value):
        return False
    try:
        uuid.UUID(value)
    except ValueError:
        return False
    return True


def semver(value: str) -> tuple[int, int, int]:
    match = SEMVER.fullmatch(value)
    if not match:
        raise RuntimeError(f"Invalid semantic version: {value}")
    return tuple(int(part) for part in match.groups())


def state_path(root: Path) -> Path:
    return root / "config" / STATE_NAME


def read_state(root: Path) -> dict:
    path = state_path(root)
    if not path.exists():
        current = current_version(root)
        return {"currentVersion": current, "targetVersion": None, "latestVersion": None,
                "updateAvailable": False, "channel": SUPPORTED_CHANNEL, "phase": "idle",
                "progress": 0, "message": "WhereHouse is up to date", "errorCode": None,
                "errorMessage": None, "rollbackPerformed": False, "lastCheckedAt": None}
    return json.loads(path.read_text())


def write_state(root: Path, **changes) -> dict:
    state = read_state(root)
    state.update(changes)
    state["updatedAt"] = utc_now()
    atomic_write(state_path(root), json.dumps(state, indent=2, sort_keys=True) + "\n")
    return state


def current_version(root: Path) -> str:
    marker = root / "releases/current"
    if marker.exists():
        value = marker.read_text().strip()
        semver(value)
        return value
    value = parse_env(root / "config/appliance.env").get("WHEREHOUSE_VERSION") or parse_env(
        root / "config/appliance.env"
    ).get("APPLIANCE_IMAGE_VERSION", "0.0.0")
    try:
        semver(value)
    except RuntimeError:
        return "0.0.0"
    return value


def validate_manifest(data: object, appliance_version: str) -> dict:
    if not isinstance(data, dict):
        raise RuntimeError("Release manifest must be a JSON object")
    required = {"schemaVersion": int, "product": str, "version": str, "channel": str,
                "architecture": str, "minimumApplianceVersion": str, "minimumCurrentVersion": str,
                "minimumSchemaRevision": int, "maximumSchemaRevision": int,
                "migrationPolicy": str, "validationScenario": str, "runtimeUrl": str,
                "runtimeSha256": str, "runtimeSize": int, "publishedAt": str,
                "releaseNotes": str, "requiresReboot": bool, "signatureAlgorithm": str}
    for field, kind in required.items():
        if field not in data or type(data[field]) is not kind:
            raise RuntimeError(f"Release manifest field is invalid: {field}")
    if data["schemaVersion"] != 1 or data["product"] != PRODUCT:
        raise RuntimeError("Release manifest is for an unsupported product or schema")
    version = semver(data["version"])
    minimum = semver(data["minimumApplianceVersion"])
    appliance = semver(appliance_version)
    minimum_current = semver(data["minimumCurrentVersion"])
    if data["channel"] != SUPPORTED_CHANNEL or data["architecture"] != ARCHITECTURE:
        raise RuntimeError("Release channel or architecture is not supported")
    if appliance < minimum:
        raise RuntimeError("Release requires a newer appliance image")
    if data["minimumSchemaRevision"] < 0 or data["maximumSchemaRevision"] < data["minimumSchemaRevision"]:
        raise RuntimeError("Release schema compatibility range is invalid")
    if data["migrationPolicy"] != "expand-contract":
        raise RuntimeError("Release migration policy is unsupported")
    if data["validationScenario"] not in {"normal", "fail-health"}:
        raise RuntimeError("Release validation scenario is unsupported")
    url = parse.urlparse(data["runtimeUrl"])
    if url.scheme != "https" or not url.netloc or url.username or url.password:
        raise RuntimeError("Release runtime URL must be HTTPS")
    if not re.fullmatch(r"[0-9a-f]{64}", data["runtimeSha256"]):
        raise RuntimeError("Release checksum is invalid")
    if data["runtimeSize"] <= 0 or data["requiresReboot"]:
        raise RuntimeError("Release size or reboot policy is unsupported")
    if data["signatureAlgorithm"] != "rsa-sha256":
        raise RuntimeError("Release signature algorithm is unsupported")
    datetime.fromisoformat(data["publishedAt"].replace("Z", "+00:00"))
    return dict(data, _version=version, _minimum_current=minimum_current)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def download(url: str, destination: Path, expected_size: int | None = None) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(f".{destination.name}.partial")
    temporary.unlink(missing_ok=True)
    try:
        with request.urlopen(url, timeout=60) as response, temporary.open("wb") as target:
            length = response.headers.get("Content-Length")
            if length and expected_size is not None and int(length) != expected_size:
                raise RuntimeError("Downloaded release size does not match manifest")
            shutil.copyfileobj(response, target, length=1024 * 1024)
            target.flush()
            os.fsync(target.fileno())
        if expected_size is not None and temporary.stat().st_size != expected_size:
            raise RuntimeError("Downloaded release is incomplete")
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def verify_signature(manifest: Path, signature: Path, public_key: Path) -> None:
    if not public_key.is_file():
        raise RuntimeError("Release verification key is not installed")
    result = subprocess.run(
        ["openssl", "dgst", "-sha256", "-verify", str(public_key), "-signature",
         str(signature), str(manifest)], capture_output=True
    )
    if result.returncode:
        raise RuntimeError("Release publisher signature is invalid")


def source_url(root: Path) -> str:
    url = parse_env(root / "config/appliance.env").get("WHEREHOUSE_UPDATE_MANIFEST_URL", "")
    parsed = parse.urlparse(url)
    if parsed.scheme != "https" or not parsed.netloc or parsed.username or parsed.password:
        raise RuntimeError("A trusted HTTPS update manifest URL is not configured")
    return url


def fetch_manifest(root: Path, public_key: Path) -> tuple[dict, Path]:
    write_state(root, phase="checking", message="Checking for updates", errorCode=None,
                errorMessage=None)
    release_dir = root / "releases/discovery"
    manifest_path = release_dir / "release.json"
    signature_path = release_dir / "release.json.sig"
    url = source_url(root)
    download(url, manifest_path)
    download(url + ".sig", signature_path)
    verify_signature(manifest_path, signature_path, public_key)
    manifest = validate_manifest(json.loads(manifest_path.read_text()),
                                 parse_env(root / "config/appliance.env").get(
                                     "APPLIANCE_IMAGE_VERSION", "0.0.0"))
    current = semver(current_version(root))
    if current < manifest["_minimum_current"]:
        raise RuntimeError("Release does not support the installed application version")
    if manifest["_version"] < current:
        raise RuntimeError("Release downgrade is not permitted")
    installed_schema = int(parse_env(root / "config/appliance.env").get(
        "WHEREHOUSE_SCHEMA_REVISION", str(CURRENT_SCHEMA_REVISION)
    ))
    if not manifest["minimumSchemaRevision"] <= installed_schema <= manifest["maximumSchemaRevision"]:
        raise RuntimeError("Release does not support the installed database schema")
    available = current < manifest["_version"]
    write_state(root, currentVersion=current_version(root), latestVersion=manifest["version"],
                targetVersion=manifest["version"] if available else None,
                updateAvailable=available, channel=manifest["channel"], phase="available" if available else "idle",
                progress=0, message="Update available" if available else "WhereHouse is up to date",
                releaseNotes=manifest["releaseNotes"], runtimeSize=manifest["runtimeSize"],
                publishedAt=manifest["publishedAt"], lastCheckedAt=utc_now())
    return manifest, manifest_path


def download_release(root: Path, manifest: dict, signed_manifest: Path) -> Path:
    version = manifest["version"]
    release_dir = root / "releases" / version
    release_dir.mkdir(parents=True, exist_ok=True)
    write_state(root, phase="downloading", progress=5, message="Downloading update")
    archive = release_dir / "wherehouse-runtime.tar"
    download(manifest["runtimeUrl"], archive, manifest["runtimeSize"])
    write_state(root, phase="verifying", progress=30, message="Verifying update")
    if sha256(archive) != manifest["runtimeSha256"]:
        archive.unlink(missing_ok=True)
        raise RuntimeError("Release checksum verification failed")
    shutil.copy2(signed_manifest, release_dir / "release.json")
    shutil.copy2(signed_manifest.with_name("release.json.sig"), release_dir / "release.json.sig")
    atomic_write(release_dir / "wherehouse-runtime.tar.sha256",
                 f"{manifest['runtimeSha256']}  wherehouse-runtime.tar\n", 0o644)
    return archive


class LifecycleLock:
    def __init__(self, root: Path):
        self.path = root / "config" / LOCK_NAME
        self.handle = None

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.handle = self.path.open("a+")
        try:
            fcntl.flock(self.handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("Another appliance lifecycle operation is already running") from exc
        return self

    def __exit__(self, *_args):
        assert self.handle
        fcntl.flock(self.handle, fcntl.LOCK_UN)
        self.handle.close()


def atomic_write(path: Path, content: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "w") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def parse_env(path: Path) -> dict[str, str]:
    if not path.exists():
        return {}
    return dict(
        line.rstrip("\n").split("=", 1)
        for line in path.read_text().splitlines()
        if line and not line.startswith("#") and "=" in line
    )


def storage_state_path(root: Path) -> Path:
    return root / "config" / STORAGE_STATE_NAME


def read_storage_state(root: Path) -> dict:
    path = storage_state_path(root)
    if not path.exists():
        return {"schemaVersion": 1, "primary": "internal", "filesystemUuid": None,
                "device": None, "phase": "healthy", "message": "Internal storage is ready",
                "nas": {"enabled": False, "share": NAS_SHARE, "username": None}}
    return json.loads(path.read_text())


def write_storage_state(root: Path, state: dict) -> None:
    atomic_write(storage_state_path(root), json.dumps(state, indent=2, sort_keys=True) + "\n")


def _json_command(command: list[str]) -> object:
    result = subprocess.run(command, check=True, capture_output=True, text=True)
    return json.loads(result.stdout)


def _backing_disk(path: str) -> str:
    source = subprocess.run(["findmnt", "-n", "-o", "SOURCE", "--target", path],
                            check=True, capture_output=True, text=True).stdout.strip()
    if source.startswith("/dev/"):
        parent = subprocess.run(["lsblk", "-n", "-o", "PKNAME", source], check=True,
                                capture_output=True, text=True).stdout.strip()
        return f"/dev/{parent}" if parent else source
    return source


def _protected_devices() -> set[str]:
    protected: set[str] = set()
    for target in ("/", "/boot", "/boot/firmware"):
        try:
            source = subprocess.run(["findmnt", "-n", "-o", "SOURCE", "--target", target],
                                    check=True, capture_output=True, text=True).stdout.strip()
        except subprocess.CalledProcessError:
            continue
        if source.startswith("/dev/"):
            protected.add(source)
            protected.add(_backing_disk(target))
    return protected


def list_storage_devices(root: Path) -> list[dict]:
    data = _json_command(["lsblk", "--json", "--bytes", "--paths", "--output",
                          "NAME,KNAME,PKNAME,TYPE,SIZE,MODEL,VENDOR,TRAN,FSTYPE,UUID,SERIAL,WWN,MOUNTPOINTS"])
    protected = _protected_devices()
    active = read_storage_state(root)
    devices = []
    for disk in data.get("blockdevices", []):
        if disk.get("type") != "disk":
            continue
        children = disk.get("children") or []
        identities = {disk.get("name"), *(part.get("name") for part in children)}
        is_protected = bool(identities & protected)
        connection = (disk.get("tran") or "").lower()
        identity_material = disk.get("wwn") or disk.get("serial")
        selectable = connection == "usb" and not is_protected and bool(identity_material)
        partitions = [{key: part.get(key) for key in ("name", "size", "fstype", "uuid", "mountpoints")}
                      for part in children]
        filesystem_uuid = next((part.get("uuid") for part in children if part.get("uuid")), disk.get("uuid"))
        mountpoints = [point for item in [disk, *children] for point in (item.get("mountpoints") or []) if point]
        usage = None
        if mountpoints:
            try:
                disk_usage = shutil.disk_usage(mountpoints[0])
                usage = {"totalBytes": disk_usage.total, "usedBytes": disk_usage.used,
                         "freeBytes": disk_usage.free}
            except OSError:
                pass
        stable_id = hashlib.sha256(f"{identity_material}|{disk.get('model')}|{disk.get('size')}".encode()).hexdigest()[:32]
        devices.append({"id": stable_id, "devicePath": disk.get("name"), "model": (disk.get("model") or "").strip() or None,
                        "vendor": (disk.get("vendor") or "").strip() or None,
                        "capacityBytes": disk.get("size"), "connection": connection or None,
                        "filesystem": next((part.get("fstype") for part in children if part.get("fstype")), disk.get("fstype")),
                        "filesystemUuid": filesystem_uuid, "mountPoints": mountpoints,
                        "partitions": partitions, "usage": usage, "primary": filesystem_uuid == active.get("filesystemUuid"),
                        "selectable": selectable,
                        "unselectableReason": "Operating system storage is protected" if is_protected else
                        ("Only attached USB disks are supported" if connection != "usb" else
                         ("The disk has no stable hardware identifier" if not identity_material else None))})
    return devices


def _selected_disk(root: Path, device_id: str) -> dict:
    matches = [item for item in list_storage_devices(root) if item["id"] == device_id]
    if len(matches) != 1 or not matches[0]["selectable"]:
        raise RuntimeError("The selected disk is unavailable or protected")
    return matches[0]


def prepare_storage(root: Path, device_id: str, expected_id: str, confirmation: str) -> dict:
    if confirmation != STORAGE_CONFIRMATION:
        raise RuntimeError(f"Drive preparation requires exact confirmation: {STORAGE_CONFIRMATION}")
    with LifecycleLock(root):
        disk = _selected_disk(root, device_id)
        device_path = disk["devicePath"]
        if disk["id"] != expected_id or device_path in _protected_devices():
            raise RuntimeError("Disk identity changed; preparation was cancelled")
        state = read_storage_state(root)
        state.update(phase="preparing", message="Preparing external storage")
        write_storage_state(root, state)
        subprocess.run(["wipefs", "--all", device_path], check=True)
        subprocess.run(["parted", "--script", device_path, "mklabel", "gpt", "mkpart", "primary", "ext4", "0%", "100%"], check=True)
        subprocess.run(["udevadm", "settle"], check=True)
        refreshed = _selected_disk(root, device_id)
        partition = next((part["name"] for part in refreshed["partitions"] if part["name"]), None)
        if not partition:
            raise RuntimeError("Prepared disk partition was not discovered")
        subprocess.run(["mkfs.ext4", "-F", "-L", "wherehouse-storage", partition], check=True)
        subprocess.run(["udevadm", "settle"], check=True)
        refreshed = _selected_disk(root, device_id)
        filesystem_uuid = refreshed.get("filesystemUuid")
        if not valid_filesystem_uuid(filesystem_uuid):
            raise RuntimeError("Prepared filesystem has no valid UUID")
        state.update(phase="prepared", message="External storage is ready", device={k: disk[k] for k in ("id", "model", "vendor", "capacityBytes")}, filesystemUuid=filesystem_uuid)
        write_storage_state(root, state)
        return state


def _mount_uuid(filesystem_uuid: str) -> None:
    if not valid_filesystem_uuid(filesystem_uuid):
        raise RuntimeError("Invalid filesystem UUID")
    STORAGE_MOUNT.mkdir(parents=True, exist_ok=True)
    subprocess.run(["mount", "-t", "ext4", f"UUID={filesystem_uuid}", str(STORAGE_MOUNT)], check=True)


def migrate_storage(root: Path, filesystem_uuid: str) -> dict:
    if not valid_filesystem_uuid(filesystem_uuid):
        raise RuntimeError("Invalid filesystem UUID")
    with LifecycleLock(root):
        state = read_storage_state(root)
        original_state = dict(state)
        fstab = Path("/etc/fstab")
        original_fstab = fstab.read_text()
        source = root.resolve()
        state.update(phase="migrating", message="Moving application data")
        write_storage_state(root, state)
        compose(root, "down", check=False)
        try:
            _mount_uuid(filesystem_uuid)
            application = STORAGE_MOUNT / "application"
            shares = STORAGE_MOUNT / "shares"
            backups = STORAGE_MOUNT / "backups"
            for path, mode in ((application, 0o700), (shares, 0o750), (backups, 0o700)):
                path.mkdir(parents=True, exist_ok=True, mode=mode)
            subprocess.run(["rsync", "-aHAX", "--numeric-ids", f"{source}/", f"{application}/"], check=True)
            verification = subprocess.run(["rsync", "-aHAXnc", "--delete", "--itemize-changes",
                                           f"{source}/", f"{application}/"], check=True,
                                          capture_output=True, text=True)
            if verification.stdout.strip():
                raise RuntimeError("Copied application data failed checksum verification")
            if (source / "backups").exists():
                subprocess.run(["rsync", "-aHAX", "--numeric-ids", f"{source / 'backups'}/", f"{backups}/"], check=True)
                backup_verification = subprocess.run(
                    ["rsync", "-aHAXnc", "--delete", "--itemize-changes", f"{source / 'backups'}/", f"{backups}/"],
                    check=True, capture_output=True, text=True)
                if backup_verification.stdout.strip():
                    raise RuntimeError("Copied backups failed checksum verification")
                shutil.rmtree(application / "backups")
                (application / "backups").mkdir(mode=0o700)
            if application.stat().st_dev == source.stat().st_dev:
                raise RuntimeError("External storage did not mount on a distinct filesystem")
            marker = "# WhereHouse primary storage"
            lines = [line for line in fstab.read_text().splitlines()
                     if marker not in line and str(STORAGE_MOUNT) not in line]
            entries = (f"UUID={filesystem_uuid} {STORAGE_MOUNT} ext4 defaults,nofail,x-systemd.device-timeout=30 0 2 {marker}\n"
                       f"{application} {root} none bind,x-systemd.requires-mounts-for={STORAGE_MOUNT} 0 0 {marker}\n"
                       f"{backups} {root / 'backups'} none bind,x-systemd.requires-mounts-for={STORAGE_MOUNT} 0 0 {marker}\n")
            atomic_write(fstab, "\n".join(lines) + "\n" + entries, 0o644)
            state.update(primary="external", filesystemUuid=filesystem_uuid, phase="healthy", message="External storage is ready")
            write_storage_state(application, state)
            # Retain the external-primary marker on the SD copy as a fail-closed boot guard.
            write_storage_state(root, state)
            subprocess.run(["mount", "--bind", str(application), str(root)], check=True)
            subprocess.run(["mount", "--bind", str(backups), str(root / "backups")], check=True)
            compose(root, "up", "-d", "--wait")
            verify_http_services()
            return state
        except Exception:
            subprocess.run(["umount", str(root / "backups")], check=False)
            subprocess.run(["umount", str(root)], check=False)
            atomic_write(fstab, original_fstab, 0o644)
            compose(root, "up", "-d", check=False)
            original_state.update(phase="failed", message="Migration failed; internal storage was restored")
            write_storage_state(root, original_state)
            raise


def configure_nas(root: Path, enabled: bool, username: str | None = None, password: str | None = None) -> dict:
    with LifecycleLock(root):
        state = read_storage_state(root)
        if enabled:
            if state.get("primary") != "external" or not STORAGE_MOUNT.is_mount():
                raise RuntimeError("Network Storage requires healthy external primary storage")
            if not username or not NAS_USER_RE.fullmatch(username):
                raise RuntimeError("NAS username must start with a letter and contain only lowercase letters, numbers, _ or -")
            if not password or len(password) < 12 or len(password) > 128:
                raise RuntimeError("NAS password must contain 12 to 128 characters")
            share = STORAGE_MOUNT / "shares" / NAS_SHARE
            share.mkdir(parents=True, exist_ok=True, mode=0o750)
            subprocess.run(["useradd", "--system", "--no-create-home", "--shell", "/usr/sbin/nologin", username], check=False)
            subprocess.run(["chown", f"{username}:{username}", str(share)], check=True)
            subprocess.run(["smbpasswd", "-s", "-a", username], input=f"{password}\n{password}\n", text=True, check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            config = f"""[global]\n   server role = standalone server\n   map to guest = Never\n   disable netbios = yes\n\n[{NAS_SHARE}]\n   path = {share}\n   valid users = {username}\n   read only = no\n   guest ok = no\n   follow symlinks = no\n   wide links = no\n"""
            atomic_write(Path("/etc/samba/smb.conf"), config, 0o644)
            subprocess.run(["testparm", "-s"], check=True, stdout=subprocess.DEVNULL)
            subprocess.run(["systemctl", "enable", "--now", "smbd.service"], check=True)
            state["nas"] = {"enabled": True, "share": NAS_SHARE, "username": username}
        else:
            subprocess.run(["systemctl", "disable", "--now", "smbd.service"], check=False)
            state["nas"] = {"enabled": False, "share": NAS_SHARE, "username": state.get("nas", {}).get("username")}
        write_storage_state(root, state)
        return state


def initialize(root: Path, hostname: Optional[str], image_version: str, build_date: str) -> bool:
    env_file = root / "config/appliance.env"
    existing = parse_env(env_file)
    required = {"INSTANCE_ID", "POSTGRES_PASSWORD", "APP_SECRET"}
    if required.issubset(existing):
        validate_storage(root)
        return False
    if existing:
        raise RuntimeError("Incomplete appliance configuration; refusing to replace existing state")
    for directory in ("postgres", "uploads", "backups", "backup-staging", "config", "releases"):
        (root / directory).mkdir(parents=True, exist_ok=True)
    hostname = hostname or socket.gethostname().split(".", 1)[0] or "wherehouse"
    values = {
        "INSTANCE_ID": str(uuid.uuid4()),
        "POSTGRES_DB": "wherehouse",
        "POSTGRES_USER": "wherehouse",
        "POSTGRES_PASSWORD": secrets.token_urlsafe(36),
        "APP_SECRET": secrets.token_urlsafe(64),
        "WHEREHOUSE_DATA_DIR": str(root),
        "WHEREHOUSE_HOSTNAME": hostname,
        "APPLIANCE_IMAGE_VERSION": image_version,
        "WHEREHOUSE_VERSION": image_version,
        "WHEREHOUSE_SCHEMA_REVISION": str(CURRENT_SCHEMA_REVISION),
        "APPLIANCE_BUILD_DATE": build_date,
        "WHEREHOUSE_UPDATE_MANIFEST_URL": os.environ.get("WHEREHOUSE_UPDATE_MANIFEST_URL", ""),
    }
    atomic_write(env_file, "".join(f"{key}={value}\n" for key, value in values.items()))
    atomic_write(
        root / "config/instance.json",
        json.dumps(
            {
                "instance_id": values["INSTANCE_ID"],
                "initialized_at": datetime.now(timezone.utc).isoformat(),
                "image_version": image_version,
            },
            indent=2,
        )
        + "\n",
    )
    validate_storage(root)
    return True


def validate_storage(root: Path, minimum_free: int = 512 * 1024 * 1024) -> None:
    if not root.is_dir() or not os.access(root, os.W_OK):
        raise RuntimeError(f"Data directory is unavailable or not writable: {root}")
    state = read_storage_state(root)
    if state.get("primary") == "external":
        expected = state.get("filesystemUuid")
        try:
            actual = subprocess.run(["findmnt", "-n", "-o", "UUID", "--target", str(root)],
                                    check=True, capture_output=True, text=True).stdout.strip()
        except subprocess.CalledProcessError as exc:
            raise RuntimeError("Primary storage unavailable; reconnect the configured drive") from exc
        if not expected or actual.lower() != str(expected).lower():
            raise RuntimeError("Primary storage unavailable; the mounted drive identity is incorrect")
    free = shutil.disk_usage(root).free
    if free < minimum_free:
        raise RuntimeError(f"Insufficient free space in {root}: {free} bytes")


def compose(root: Path, *arguments: str, check: bool = True) -> subprocess.CompletedProcess:
    command = [
        *compose_command(root),
        *arguments,
    ]
    return subprocess.run(command, check=check)


def compose_command(root: Path) -> list[str]:
    env_file = root / "config/appliance.env"
    return [
        "docker", "compose", "--env-file", str(env_file),
        "-f", str(INSTALL_DIR / "docker-compose.yml"),
        "-f", str(INSTALL_DIR / "deploy/raspberry-pi/compose.appliance.yaml"),
    ]


def verify_http_services() -> None:
    urls = ("http://127.0.0.1/api/v1/health", "http://127.0.0.1/")
    deadline = time.monotonic() + 60
    last_error: Exception | None = None
    while time.monotonic() < deadline:
        try:
            for url in urls:
                with request.urlopen(url, timeout=5) as response:
                    if response.status >= 400:
                        raise RuntimeError("Updated service health check failed")
            return
        except (error.HTTPError, error.URLError, TimeoutError, RuntimeError) as exc:
            last_error = exc
            time.sleep(2)
    raise subprocess.CalledProcessError(1, ["health-check", *urls]) from last_error


def _command_health(command: list[str]) -> str:
    try:
        result = subprocess.run(command, check=False, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return "unavailable"
    return "healthy" if result.returncode == 0 else "failed"


def health_status(root: Path) -> dict:
    env = parse_env(root / "config/appliance.env")
    storage = read_storage_state(root)
    backups = root / "backups"
    return {
        "version": current_version(root),
        "imageVersion": env.get("APPLIANCE_IMAGE_VERSION", "unknown"),
        "services": {
            "docker": _command_health(["systemctl", "is-active", "--quiet", "docker.service"]),
            "appliance": _command_health(["systemctl", "is-active", "--quiet", "wherehouse.service"]),
            "updater": _command_health(["systemctl", "is-active", "--quiet", "wherehouse-update.service"]),
            "api": _command_health(["curl", "--fail", "--silent", "http://127.0.0.1/api/v1/health"]),
            "web": _command_health(["curl", "--fail", "--silent", "http://127.0.0.1/"]),
            "database": _command_health([*compose_command(root), "exec", "-T", "postgres",
                                          "pg_isready", "-U", env.get("POSTGRES_USER", "wherehouse"),
                                          "-d", env.get("POSTGRES_DB", "wherehouse")]),
        },
        "storage": {"phase": storage.get("phase", "unknown"),
                    "primary": storage.get("primary", "unknown")},
        "networkStorage": "enabled" if storage.get("nas", {}).get("enabled") else "disabled",
        "backup": "present" if backups.is_dir() and any(backups.iterdir()) else "none recorded",
    }


def print_health_status(status: dict) -> None:
    print(f"WhereHouse version: {status['version']} (image {status['imageVersion']})")
    for name, value in status["services"].items():
        print(f"{name.replace('_', ' ').title()}: {value}")
    print(f"Storage: {status['storage']['phase']} ({status['storage']['primary']})")
    print(f"Network/NAS: {status['networkStorage']}")
    print(f"Backup: {status['backup']}")


def install_release(root: Path, release: str) -> None:
    validate_storage(root, 1024 * 1024 * 1024)
    archive = root / "releases" / release / "wherehouse-runtime.tar"
    if not archive.is_file():
        raise RuntimeError(f"Release payload is missing: {archive}")
    manifest = json.loads((archive.parent / "release.json").read_text())
    # Database migrations can be irreversible. Preserve a verified recovery artifact first.
    write_state(root, targetVersion=release, phase="backing_up", progress=40,
                message="Creating verified backup")
    subprocess.run(
        [str(INSTALL_DIR / "deploy/raspberry-pi/wherehouse-backup"), "create"], check=True
    )
    previous = {}
    for image in ("wherehouse-api:local", "wherehouse-web:local"):
        result = subprocess.run(
            ["docker", "image", "inspect", "--format", "{{.Id}}", image],
            check=True,
            capture_output=True,
            text=True,
        )
        previous[image] = result.stdout.strip()
    write_state(root, phase="installing", progress=55, message="Installing update")
    subprocess.run(["docker", "load", "--input", str(archive)], check=True)
    for image in (f"wherehouse-api:{release}", f"wherehouse-web:{release}"):
        subprocess.run(["docker", "image", "inspect", image], check=True,
                       stdout=subprocess.DEVNULL)
    subprocess.run(["docker", "tag", f"wherehouse-api:{release}", "wherehouse-api:local"], check=True)
    subprocess.run(["docker", "tag", f"wherehouse-web:{release}", "wherehouse-web:local"], check=True)
    env_path = root / "config/appliance.env"
    env = parse_env(env_path)
    previous_version = env.get("WHEREHOUSE_VERSION", env.get("APPLIANCE_IMAGE_VERSION", "0.0.0"))
    env["WHEREHOUSE_VERSION"] = release
    atomic_write(env_path, "".join(f"{key}={value}\n" for key, value in env.items()))
    try:
        write_state(root, phase="migrating", progress=70, message="Updating database")
        compose(root, "up", "migrate", check=True)
        env["WHEREHOUSE_SCHEMA_REVISION"] = str(manifest["maximumSchemaRevision"])
        atomic_write(env_path, "".join(f"{key}={value}\n" for key, value in env.items()))
        write_state(root, phase="restarting", progress=82, message="Restarting services")
        compose(root, "up", "-d", "--wait", check=True)
        write_state(root, phase="health_check", progress=92, message="Verifying installation")
        verify_http_services()
        if manifest.get("validationScenario") == "fail-health":
            raise subprocess.CalledProcessError(1, ["signed-failure-drill", "health"])
    except subprocess.CalledProcessError:
        env["WHEREHOUSE_VERSION"] = previous_version
        atomic_write(env_path, "".join(f"{key}={value}\n" for key, value in env.items()))
        for image, image_id in previous.items():
            subprocess.run(["docker", "tag", image_id, image], check=True)
        compose(root, "up", "-d", check=False)
        write_state(root, phase="failed", progress=100, message="Update failed; previous application restored",
                    errorCode="install_failed", errorMessage="Installation failed. Use the pre-update backup if the database is incompatible.",
                    rollbackPerformed=True)
        raise RuntimeError(
            "Update health validation failed. Previous containers were restored, but a database "
            "migration may prevent application rollback; follow the documented backup restore path."
        )
    atomic_write(root / "releases/current", release + "\n")
    write_state(root, currentVersion=release, targetVersion=None, latestVersion=release,
                updateAvailable=False, phase="completed", progress=100,
                message="WhereHouse is up to date", errorCode=None, errorMessage=None,
                rollbackPerformed=False)
    retain_releases(root)


def retain_releases(root: Path, keep: int = 3) -> None:
    releases = []
    for candidate in (root / "releases").iterdir():
        if candidate.is_dir() and SEMVER.fullmatch(candidate.name):
            releases.append((semver(candidate.name), candidate))
    protected = {current_version(root), read_state(root).get("targetVersion")}
    removable = [path for _, path in sorted(releases, reverse=True)[keep:]
                 if path.name not in protected]
    for path in removable:
        shutil.rmtree(path)


def recover_interrupted_update(root: Path) -> None:
    for partial in (root / "releases").glob("**/*.partial"):
        partial.unlink(missing_ok=True)
    state = read_state(root)
    if state.get("phase") in {
        "checking", "downloading", "verifying", "backing_up", "installing",
        "migrating", "restarting", "health_check", "rollback",
    }:
        write_state(root, phase="failed", progress=100,
                    message="Update was interrupted; current installation requires verification",
                    errorCode="update_interrupted",
                    errorMessage="The appliance restarted during an update. Check service health before retrying.",
                    rollbackPerformed=False)


def perform_update(root: Path, public_key: Path) -> None:
    try:
        with LifecycleLock(root):
            manifest, path = fetch_manifest(root, public_key)
            if semver(current_version(root)) >= manifest["_version"]:
                return
            download_release(root, manifest, path)
            install_release(root, manifest["version"])
    except Exception as exc:
        state = read_state(root)
        if state.get("phase") != "failed":
            write_state(root, phase="failed", progress=100, message="Update failed",
                        errorCode="update_failed",
                        errorMessage="The update could not be completed. Review appliance logs before retrying.",
                        rollbackPerformed=False)
        raise


def start_update(root: Path, public_key: Path) -> None:
    if read_state(root).get("phase") in {
        "checking", "downloading", "verifying", "backing_up", "installing",
        "migrating", "restarting", "health_check", "rollback",
    }:
        raise RuntimeError("Another appliance lifecycle operation is already running")
    write_state(root, phase="checking", message="Starting update", progress=0)
    thread = threading.Thread(target=lambda: _background_update(root, public_key), daemon=True)
    thread.start()


def _background_update(root: Path, public_key: Path) -> None:
    try:
        perform_update(root, public_key)
    except Exception as exc:
        print(f"wherehouse-ops: background update failed: {exc}", file=sys.stderr)


def appliance_status(root: Path) -> dict:
    state = read_storage_state(root)
    try:
        usage = shutil.disk_usage(root)
        state["usage"] = {"totalBytes": usage.total, "usedBytes": usage.used, "freeBytes": usage.free,
                          "percentUsed": round(usage.used * 100 / usage.total, 1)}
        if state.get("phase") == "healthy" and usage.free < 2 * 1024 * 1024 * 1024:
            state.update(phase="low_space", message="Primary storage is running low on free space")
    except OSError:
        state["usage"] = None
    state["devices"] = [{key: value for key, value in device.items() if key != "devicePath"}
                        for device in list_storage_devices(root)]
    state["mountPoint"] = str(STORAGE_MOUNT) if state.get("primary") == "external" else None
    state["nas"]["server"] = f"{parse_env(root / 'config/appliance.env').get('WHEREHOUSE_HOSTNAME', 'wherehouse')}.local"
    state["nas"]["address"] = f"smb://{state['nas']['server']}/{NAS_SHARE}"
    if state.get("primary") == "external" and not STORAGE_MOUNT.is_mount():
        state.update(phase="unavailable", message="Primary storage unavailable")
        state["nas"]["available"] = False
    else:
        state["nas"]["available"] = bool(state["nas"].get("enabled"))
    return state


def serve(root: Path, socket_path: Path, public_key: Path) -> None:
    recover_interrupted_update(root)
    socket_path.parent.mkdir(parents=True, exist_ok=True)
    socket_path.unlink(missing_ok=True)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(socket_path))
    # The API container runs as root and receives this socket explicitly. Do not grant every local
    # account permission to trigger privileged lifecycle/storage operations.
    os.chmod(socket_path, 0o660)
    server.listen(8)
    while True:
        connection, _ = server.accept()
        with connection:
            try:
                raw = connection.recv(65536).decode().strip()
                payload = json.loads(raw) if raw.startswith("{") else {"operation": raw}
                command = payload.get("operation")
                if command == "status":
                    response = {"ok": True, "status": read_state(root)}
                elif command == "check":
                    with LifecycleLock(root):
                        fetch_manifest(root, public_key)
                    response = {"ok": True, "status": read_state(root)}
                elif command == "install":
                    with LifecycleLock(root):
                        pass
                    start_update(root, public_key)
                    response = {"ok": True, "status": read_state(root)}
                elif command == "storage.status":
                    response = {"ok": True, "status": appliance_status(root)}
                elif command == "storage.prepare":
                    response = {"ok": True, "status": prepare_storage(
                        root, payload.get("deviceId", ""), payload.get("expectedDeviceId", ""),
                        payload.get("confirmation", ""))}
                elif command == "storage.migrate":
                    response = {"ok": True, "status": migrate_storage(root, payload.get("filesystemUuid", ""))}
                elif command == "nas.enable":
                    response = {"ok": True, "status": configure_nas(
                        root, True, payload.get("username"), payload.get("password"))}
                elif command == "nas.disable":
                    response = {"ok": True, "status": configure_nas(root, False)}
                else:
                    response = {"ok": False, "error": "Unsupported operation"}
            except Exception as exc:
                if command == "check" and read_state(root).get("phase") == "checking":
                    write_state(root, phase="failed", progress=100, message="Update check failed",
                                errorCode="check_failed",
                                errorMessage="The update could not be checked. Verify appliance release configuration and network access.",
                                rollbackPerformed=False)
                response = {"ok": False, "error": str(exc)}
            connection.sendall((json.dumps(response) + "\n").encode())


def load_images(root: Path) -> None:
    marker = root / "config/images-loaded"
    if marker.exists():
        return
    archives = sorted((INSTALL_DIR / "deploy/raspberry-pi/images").glob("*.tar"))
    if not archives:
        raise RuntimeError("The appliance image does not contain its container payload")
    for archive in archives:
        subprocess.run(["docker", "load", "--input", str(archive)], check=True)
    atomic_write(marker, datetime.now(timezone.utc).isoformat() + "\n")


def factory_reset(root: Path, confirmation: str, delete_backups: bool) -> None:
    expected = "DELETE ALL WHEREHOUSE DATA"
    if confirmation != expected:
        raise RuntimeError(f"Factory reset requires exact confirmation: {expected}")
    compose(root, "down", check=False)
    preserve = root / "backups"
    temporary = root.parent / f"wherehouse-backups-{uuid.uuid4()}"
    if preserve.exists() and not delete_backups:
        preserve.rename(temporary)
    shutil.rmtree(root)
    if temporary.exists():
        root.mkdir(parents=True)
        temporary.rename(preserve)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=DEFAULT_ROOT)
    sub = parser.add_subparsers(dest="command", required=True)
    init = sub.add_parser("init")
    init.add_argument("--hostname")
    init.add_argument("--image-version", default="development")
    init.add_argument("--build-date", default="unknown")
    sub.add_parser("validate-storage")
    sub.add_parser("load-images")
    upgrade = sub.add_parser("update")
    upgrade.add_argument("release", nargs="?")
    sub.add_parser("update-check")
    sub.add_parser("update-status")
    sub.add_parser("storage-status")
    status = sub.add_parser("status")
    status.add_argument("--json", action="store_true")
    daemon = sub.add_parser("update-serve")
    daemon.add_argument("--socket", type=Path, default=APPLIANCE_SOCKET)
    parser.add_argument("--public-key", type=Path,
                        default=INSTALL_DIR / "deploy/raspberry-pi/update-public-key.pem")
    reset = sub.add_parser("factory-reset")
    reset.add_argument("--confirm", required=True)
    reset.add_argument("--delete-backups", action="store_true")
    args = parser.parse_args()
    try:
        if args.command == "init":
            initialize(args.root, args.hostname, args.image_version, args.build_date)
        elif args.command == "validate-storage":
            validate_storage(args.root)
        elif args.command == "load-images":
            load_images(args.root)
        elif args.command == "update":
            if args.release:
                with LifecycleLock(args.root):
                    install_release(args.root, args.release)
            else:
                perform_update(args.root, args.public_key)
        elif args.command == "update-check":
            with LifecycleLock(args.root):
                fetch_manifest(args.root, args.public_key)
            print(json.dumps(read_state(args.root)))
        elif args.command == "update-status":
            print(json.dumps(read_state(args.root)))
        elif args.command == "storage-status":
            print(json.dumps(appliance_status(args.root)))
        elif args.command == "status":
            status_payload = health_status(args.root)
            if args.json:
                print(json.dumps(status_payload))
            else:
                print_health_status(status_payload)
        elif args.command == "update-serve":
            serve(args.root, args.socket, args.public_key)
        elif args.command == "factory-reset":
            factory_reset(args.root, args.confirm, args.delete_backups)
    except (OSError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"wherehouse-ops: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

# Backward-compatible Python entry point used by appliance lifecycle tests/tools.
update = install_release