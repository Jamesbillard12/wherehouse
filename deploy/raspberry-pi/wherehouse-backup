#!/bin/sh
set -eu

root=${WHEREHOUSE_DATA_DIR:-/var/lib/wherehouse}
base=/opt/wherehouse
compose="docker compose --env-file $root/config/appliance.env -f $base/docker-compose.yml -f $base/deploy/raspberry-pi/compose.appliance.yaml"

case "${1:-}" in
  create)
    $compose stop api
    trap '$compose start api' EXIT INT TERM
    $compose run --rm --no-deps api /app/.venv/bin/python -m app.application.backups.cli create --provider "${2:-local}"
    ;;
  *)
    echo "Usage: wherehouse-backup create [local|dropbox]" >&2
    exit 2
    ;;
esac
