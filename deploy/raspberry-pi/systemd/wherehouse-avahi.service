[Unit]
Description=Publish WhereHouse through mDNS
After=wherehouse.service avahi-daemon.service
Requires=wherehouse.service avahi-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'test "$(hostname)" = wherehouse || hostnamectl set-hostname wherehouse'
ExecStart=/usr/bin/systemctl restart avahi-daemon

[Install]
WantedBy=multi-user.target
