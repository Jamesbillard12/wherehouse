[Unit]
Description=WhereHouse application update controller
Wants=network-online.target docker.service
After=network-online.target docker.service local-fs.target
Requires=docker.service

[Service]
Type=simple
RuntimeDirectory=wherehouse
RuntimeDirectoryMode=0755
ExecStart=/opt/wherehouse/deploy/raspberry-pi/wherehouse-ops update-serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
