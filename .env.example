WHEREHOUSE_ENV=development
DATABASE_URL=postgresql+asyncpg://wherehouse:wherehouse@localhost:5432/wherehouse
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
IMAGE_STORAGE_BACKEND=local
# For cloud or S3-compatible storage, set IMAGE_STORAGE_BACKEND=s3 and configure:
# S3_BUCKET=wherehouse-images
# S3_REGION=us-west-2
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# Portable backups. The local directory must already exist (including mounted SSD paths).
BACKUP_PROVIDER=local
BACKUP_STAGING_DIR=./backup-staging
BACKUP_LOCAL_DIR=./backups
BACKUP_RETENTION_COUNT=7
# Dropbox uses an App Folder-scoped OAuth app and an offline refresh token. Never commit credentials.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_BACKUP_FOLDER=/WhereHouse/Backups
